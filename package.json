{
  "name": "dsh-lock-screen",
  "version": "1.0.0",
  "description": "Full-screen password lock for DeepSeek Harness — hide running sessions when you leave your desk. Background tasks keep running.",
  "type": "module",
  "license": "MIT",
  "author": "Zhang Xi <1178329669@qq.com>",
  "homepage": "https://github.com/Xxihagalife/dsh-lock-screen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xxihagalife/dsh-lock-screen.git"
  },
  "bugs": {
    "url": "https://github.com/Xxihagalife/dsh-lock-screen/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "lock-screen",
    "privacy",
    "password",
    "ui"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
